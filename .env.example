# Local PostgreSQL connection (used by the app and migration runner)
DATABASE_URL=postgresql://notice_notifier:local_dev_only@localhost:5432/notice_notifier

# Local PostgreSQL container settings
POSTGRES_DB=notice_notifier
POSTGRES_USER=notice_notifier
# Replace this local development password before sharing the environment.
POSTGRES_PASSWORD=local_dev_only
POSTGRES_PORT=5432
APP_PORT=8000

# Replace this value with a randomly generated secret outside development.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
# Set true when serving over HTTPS; keep false for local HTTP.
COOKIE_SECURE=false

# LLM settings. Keep real API keys in .env; never commit them.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_BASE_URL=
