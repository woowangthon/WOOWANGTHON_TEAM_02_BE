{
  "manifest_version": 3,
  "name": "충북대 새 공지 확인",
  "version": "1.5.0",
  "description": "학과 홈페이지의 새 공지와 기존 공지의 최신 내용을 알려줌에 저장합니다.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://computer.cbnu.ac.kr/*",
    "https://computer.chungbuk.ac.kr/*",
    "https://koamma.cbnu.ac.kr/*",
    "https://koamma.chungbuk.ac.kr/*",
    "https://woowangthonteam02be-production.up.railway.app/*",
    "http://localhost:8000/*",
    "http://localhost:8001/*",
    "http://127.0.0.1:8000/*",
    "http://127.0.0.1:8001/*"
  ],
  "background": { "service_worker": "service_worker.js" },
  "action": {
    "default_title": "충북대 새 공지 확인",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://computer.cbnu.ac.kr/*",
        "https://computer.chungbuk.ac.kr/*",
        "https://koamma.cbnu.ac.kr/*",
        "https://koamma.chungbuk.ac.kr/*",
        "https://woowangthonteam02be-production.up.railway.app/extension-import*",
        "http://localhost:8000/extension-import*",
        "http://localhost:8001/extension-import*",
        "http://127.0.0.1:8000/extension-import*",
        "http://127.0.0.1:8001/extension-import*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
